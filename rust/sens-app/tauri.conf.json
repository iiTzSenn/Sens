{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sens",
  "version": "0.13.0",
  "identifier": "dev.sens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w sens-app-ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w sens-app-ui",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Sens",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://icons.duckduckgo.com; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
