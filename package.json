    "brand": "tsx scripts/brand.ts"
  },
  "author": "Sofia",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.1.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
